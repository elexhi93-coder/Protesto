# ProtestGuard Albania — server configuration
# Copy these values into your environment (shell, process manager, or .env loader).
# NEVER commit real secrets. Leave ADMIN_KEY/INVITE_TOKENS/ORGANIZER_PASSCODES
# empty in production to disable the corresponding access entirely.

NODE_ENV=production

# Secret key for the admin dashboard. Leave empty to disable admin access in prod.
ADMIN_KEY=

# Comma-separated list of valid daily invite tokens.
INVITE_TOKENS=

# Comma-separated list of valid organizer passcodes.
ORGANIZER_PASSCODES=

# HTTP port (default 3000).
PORT=3000